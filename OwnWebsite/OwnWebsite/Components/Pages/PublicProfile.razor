@page "/{username}"
@layout ProfileLayout
@rendermode InteractiveServer
@using OwnWebsite.Profiles.Models
@using OwnWebsite.Profiles.Services
@inject IProfileService ProfileService

<PageTitle>@(profile?.FullName ?? "Public profile")</PageTitle>

@if (isLoading)
{
    <main class="profile-state" aria-live="polite">
        <div class="profile-spinner" role="status" aria-label="Loading profile"></div>
        <p>Loading profile...</p>
    </main>
}
else if (profile is null)
{
    <main class="profile-state profile-not-found">
        <span class="profile-state-mark" aria-hidden="true">?</span>
        <p class="eyebrow">Profile not found</p>
        <h1>We couldn’t find that profile.</h1>
        <p class="lead">The username may be misspelled, or this profile may no longer be public.</p>
        <a class="btn profile-button profile-button-primary" href="/">Return home</a>
    </main>
}
else
{
    <main class="profile-page">
        <header class="profile-hero">
            <div class="profile-cover" style="@CoverStyle"></div>
            <div class="container profile-container">
                <div class="profile-identity">
                    <img class="profile-avatar" src="@ProfileImageUrl" alt="@profile.FullName" @onerror="HandleProfileImageError" />
                    <div class="profile-identity-copy">
                        @if (HasText(profile.BusinessName))
                        {
                            <p class="profile-business">@profile.BusinessName</p>
                        }
                        <h1>@profile.FullName</h1>
                        @if (HasText(profile.ProfessionalTitle))
                        {
                            <p class="profile-title">@profile.ProfessionalTitle</p>
                        }
                        @if (HasText(profile.ShortDescription))
                        {
                            <p class="profile-intro">@profile.ShortDescription</p>
                        }
                        <div class="profile-meta">
                            @if (HasText(profile.Location))
                            {
                                <span><span class="meta-symbol" aria-hidden="true">⌖</span> @profile.Location</span>
                            }
                            @if (HasText(profile.AvailabilityStatus))
                            {
                                <span class="availability-badge"><span class="availability-dot" aria-hidden="true"></span>@profile.AvailabilityStatus</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="profile-actions">
                    @if (HasText(profile.Email))
                    {
                        <a class="btn profile-button profile-button-primary" href="mailto:@profile.Email">Get in touch</a>
                    }
                    @if (SafeExternalUrl(profile.WebsiteUrl) is not null)
                    {
                        <a class="btn profile-button profile-button-secondary" href="@SafeExternalUrl(profile.WebsiteUrl)" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a>
                    }
                </div>
            </div>
        </header>

        <div class="container profile-container profile-content">
            <div class="row g-4 g-xl-5">
                <div class="col-lg-8">
                    @if (HasText(profile.About))
                    {
                        <section class="profile-section" aria-labelledby="about-heading">
                            <p class="eyebrow">A little about me</p>
                            <h2 id="about-heading">Building work with purpose.</h2>
                            <p class="section-copy">@profile.About</p>
                        </section>
                    }

                    @if (profile.Services.Count > 0)
                    {
                        <section class="profile-section" aria-labelledby="services-heading">
                            <div class="section-heading-row">
                                <div>
                                    <p class="eyebrow">How I can help</p>
                                    <h2 id="services-heading">Services</h2>
                                </div>
                            </div>
                            <div class="row g-3">
                                @foreach (var service in profile.Services)
                                {
                                    <div class="col-md-6">
                                        <article class="service-card h-100">
                                            <div class="service-icon" aria-hidden="true">✦</div>
                                            <h3>@service.Title</h3>
                                            @if (HasText(service.Description))
                                            {
                                                <p>@service.Description</p>
                                            }
                                        </article>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (profile.Projects.Count > 0)
                    {
                        <section class="profile-section" aria-labelledby="projects-heading">
                            <p class="eyebrow">Selected work</p>
                            <h2 id="projects-heading">Projects</h2>
                            <div class="projects-grid">
                                @foreach (var project in profile.Projects)
                                {
                                    <article class="project-card">
                                        @if (HasText(project.ImageUrl))
                                        {
                                            <img src="@ProjectImageUrl(project)" alt="@project.Title project preview" @onerror="@(() => HandleProjectImageError(project))" />
                                        }
                                        <div class="project-card-body">
                                            @if (HasText(project.Category))
                                            {
                                                <p class="project-category">@project.Category</p>
                                            }
                                            <h3>@project.Title</h3>
                                            @if (HasText(project.Description))
                                            {
                                                <p>@project.Description</p>
                                            }
                                            @if (SafeExternalUrl(project.ProjectUrl) is not null)
                                            {
                                                <a class="project-link" href="@SafeExternalUrl(project.ProjectUrl)" target="_blank" rel="noopener noreferrer">View project <span aria-hidden="true">↗</span></a>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>

                <aside class="col-lg-4">
                    @if (profile.Skills.Count > 0)
                    {
                        <section class="side-card" aria-labelledby="skills-heading">
                            <p class="eyebrow">Areas of expertise</p>
                            <h2 id="skills-heading">Skills</h2>
                            <div class="skill-list">
                                @foreach (var skill in profile.Skills.Where(HasText))
                                {
                                    <span class="skill-badge">@skill</span>
                                }
                            </div>
                        </section>
                    }

                    @if (profile.YearsOfExperience is > 0)
                    {
                        <section class="side-card profile-stat-card" aria-label="Experience">
                            <span class="stat-number">@profile.YearsOfExperience<span>+</span></span>
                            <span class="stat-label">years of experience</span>
                        </section>
                    }

                    @if (profile.SocialLinks.Count > 0)
                    {
                        <section class="side-card" aria-labelledby="social-heading">
                            <p class="eyebrow">Find me online</p>
                            <h2 id="social-heading">Connect</h2>
                            <div class="social-list">
                                @foreach (var social in profile.SocialLinks)
                                {
                                    @if (SafeExternalUrl(social.Url) is not null)
                                    {
                                        <a class="social-link" href="@SafeExternalUrl(social.Url)" target="_blank" rel="noopener noreferrer">
                                            <span class="social-mark">@(string.IsNullOrWhiteSpace(social.IconClass) ? social.Platform[..1].ToUpperInvariant() : social.IconClass)</span>
                                            <span>@social.Platform</span>
                                            <span class="social-arrow" aria-hidden="true">↗</span>
                                        </a>
                                    }
                                }
                            </div>
                        </section>
                    }
                </aside>
            </div>

            @if (HasContactDetails)
            {
                <section class="contact-card" aria-labelledby="contact-heading">
                    <div>
                        <p class="eyebrow">Let’s work together</p>
                        <h2 id="contact-heading">Have a project in mind?</h2>
                        <p>Reach out and let’s start a conversation.</p>
                    </div>
                    <div class="contact-details">
                        @if (HasText(profile.Email))
                        {
                            <a href="mailto:@profile.Email">@profile.Email</a>
                        }
                        @if (HasText(profile.PhoneNumber))
                        {
                            <a href="tel:@PhoneHref">@profile.PhoneNumber</a>
                        }
                    </div>
                </section>
            }
        </div>

        <footer class="profile-footer">
            <div class="container profile-container">
                <span>@profile.FullName</span>
                <span>© @DateTime.UtcNow.Year · All rights reserved</span>
            </div>
        </footer>
    </main>
}

@code {
    [Parameter]
    public string? Username { get; set; }

    private UserProfile? profile;
    private bool isLoading = true;
    private bool profileImageFailed;
    private readonly HashSet<string> failedProjectImages = new(StringComparer.Ordinal);

    private string ProfileImageUrl => profileImageFailed || SafeImageUrl(profile?.ProfileImageUrl) is null
        ? FallbackImageUrl
        : profile.ProfileImageUrl!;

    private string CoverStyle => SafeImageUrl(profile?.CoverImageUrl) is { } coverUrl
        ? $"background-image: linear-gradient(100deg, rgba(20, 35, 37, .82), rgba(20, 35, 37, .2)), url('{coverUrl}')"
        : "background-image: linear-gradient(100deg, #183536, #2b5f5a)";

    private string PhoneHref => new string((profile?.PhoneNumber ?? string.Empty).Where(c => char.IsDigit(c) || c == '+').ToArray());
    private bool HasContactDetails => HasText(profile?.Email) || HasText(profile?.PhoneNumber) || SafeExternalUrl(profile?.WebsiteUrl) is not null;
    private const string FallbackImageUrl = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 500'%3E%3Crect width='800' height='500' fill='%232b5f5a'/%3E%3Ccircle cx='400' cy='220' r='80' fill='%23dfe9e5' opacity='.75'/%3E%3Cpath d='M230 500c20-120 110-175 170-175s150 55 170 175' fill='%23dfe9e5' opacity='.75'/%3E%3C/svg%3E";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        profile = null;
        profileImageFailed = false;
        failedProjectImages.Clear();
        profile = string.IsNullOrWhiteSpace(Username)
            ? null
            : await ProfileService.GetProfileBySlugAsync(Username);
        isLoading = false;
    }

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value);

    // private static string? SafeExternalUrl(string? value)
    // {
    //     return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
    //            (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
    //         ? uri.ToString()
    //         : null;
    // }
    private static string? SafeExternalUrl(string? value)
    {
        return !string.IsNullOrEmpty(value) ? value
            : null;
    }

    private static string? SafeImageUrl(string? value) => SafeExternalUrl(value);

    private string ProjectImageUrl(PortfolioProject project) =>
        project.ImageUrl is not null && !failedProjectImages.Contains(project.ImageUrl) && SafeImageUrl(project.ImageUrl) is not null
            ? project.ImageUrl
            : FallbackImageUrl;

    private void HandleProfileImageError() => profileImageFailed = true;

    private void HandleProjectImageError(PortfolioProject project)
    {
        if (project.ImageUrl is not null)
        {
            failedProjectImages.Add(project.ImageUrl);
        }
    }
}
